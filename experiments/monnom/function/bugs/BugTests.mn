	# BEGIN Test_IfObj K4
	public static fun SomeBox(Int v) : Box?
	{
		if(v > 0) { return new Box(v); }
		return null;
	}
	# K4: ifobj on a value that may be null is rejected (now: compile error "Local variable b
	# is never null, then-branch never taken"); ifnull on the same kind of value works
	public static fun Test_IfObj() : Void
	{
		Box? b = Main.SomeBox(4);
		Box? n = Main.SomeBox(0);
		Int r = 0;
		ifobj(b) { r = r + b.V; }
		ifnull(n) { r = r + 100; }
		if(r == 104) { Main.Pass("Test_IfObj"); }
		else { Main.Fail("Test_IfObj"); Main.Show(r); Main.End(); }
	}
	# END Test_IfObj

	# BEGIN Test_MaybeCast K5
	public static fun SomeBox2(Int v) : Box?
	{
		if(v > 0) { return new Box(v); }
		return null;
	}
	# K5: casting a maybe value T? to T is rejected (now: compile error "Expected type Box?,
	# but found Box")
	public static fun Test_MaybeCast() : Void
	{
		Box? b = Main.SomeBox2(4);
		Box c = (Box) b;
