		else { Main.Fail("Test_MaybeCast"); Main.Show(c.V); Main.End(); }
	}
	# END Test_MaybeCast

	# BEGIN Test_MaybeInstantiation K6
	# K6: a maybe type that contains a type variable, here T? in new ArrayList<T?>() inside a
	# generic class, needs a runtime instantiation: NomMaybeType::GenerateRTInstantiation
	# calls NOM_RTInstantiateMaybe, which is never declared (the same problem as R14b),
	# so CreateCall gets a null function (now: segfault while compiling Make)
	public static fun Test_MaybeInstantiation() : Void
	{
		MaybeList<Int> h = new MaybeList<Int>();
		dyn l = h.Make();
		Main.Pass("Test_MaybeInstantiation");
