{
  "cmake.sourceDirectory": "${workspaceFolder}/sourcecode/Runtime",
  "cmake.buildDirectory": "${workspaceFolder}/sourcecode/Runtime/build",
  "cmake.defaultVariants": {
    "buildType": {
      "default": "release",
      "description": "The build type.",
      "choices": {
        "release": {
          "short": "Release",
          "long": "Optimize the runtime.",
          "buildType": "Release"
        },
        "debug": {
          "short": "Debug",
          "long": "Emit debug information, no optimization.",
          "buildType": "Debug"
        }
      }
    }
  }
}